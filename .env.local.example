# ─────────────────────────────────────────────────────────────
# 냉털(냉장고 털기) AI 추천 — Gemini API  [선택]
# - 없어도 앱 전체가 정상 동작 (로컬 재료 매칭으로 자동 전환)
# - 있으면 매번 다른 창의적인 레시피 AI 추천
#
# 발급: https://aistudio.google.com → Get API key (무료)
# 무료 한도: 1,500회/일, 15회/분
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# 오늘 메뉴 레시피 팝업 — Anthropic API  [선택]
# - 없어도 앱 전체가 정상 동작
# - 있으면 메인 메뉴 탭 시 Claude AI 레시피 표시
#
# 발급: https://console.anthropic.com → API Keys
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
